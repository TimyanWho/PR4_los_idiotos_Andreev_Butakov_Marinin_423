<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход и регистрация"
      Background="#F3F5FA">
    <Grid Margin="24">
        <Border MaxWidth="1040" MinHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="20" BorderBrush="#E5E9F2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#172B55" CornerRadius="20,0,0,20" Padding="42">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GMWOG" Foreground="White" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text="Покупки без лишней суеты" Foreground="#D8E3FF" FontSize="18" Margin="0,12,0,0" />
                        <TextBlock Text="Войдите, чтобы продолжить покупки, или создайте аккаунт за пару минут." Foreground="#B7C5E3" FontSize="14" TextWrapping="Wrap" Margin="0,18,0,30" />
                        <Border Background="#233B6E" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <TextBlock Text="✓  Корзина и избранное в одном месте" Foreground="White" FontSize="14" />
                        </Border>
                        <Border Background="#233B6E" CornerRadius="12" Padding="16">
                            <TextBlock Text="✓  История заказов и статусы доставки" Foreground="White" FontSize="14" />
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="42" VerticalAlignment="Center">
                        <TextBlock Text="Рады видеть вас" Foreground="#172B55" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText" Text="Войдите в аккаунт, чтобы продолжить." Foreground="#6B7280" FontSize="14" Margin="0,8,0,24" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LoginModeButton" Grid.Column="0" Content="Вход" Height="42" Click="LoginMode_Click"
                                    Background="#EAF0FF" Foreground="#244A9B" BorderBrush="#D8E2FA" BorderThickness="1" FontWeight="SemiBold" />
                            <Button x:Name="RegisterModeButton" Grid.Column="1" Content="Регистрация" Height="42" Click="RegisterMode_Click"
                                    Background="White" Foreground="#667085" BorderBrush="#E5E7EB" BorderThickness="1" FontWeight="SemiBold" />
                        </Grid>

                        <TextBlock Text="Логин" Foreground="#344054" FontSize="13" FontWeight="SemiBold" />
                        <TextBox x:Name="LoginBox" Height="44" Margin="0,7,0,18" Padding="12,9" FontSize="15" BorderBrush="#D0D5DD" />

                        <TextBlock Text="Пароль" Foreground="#344054" FontSize="13" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordBox" Height="44" Margin="0,7,0,18" Padding="12,9" FontSize="15" BorderBrush="#D0D5DD" />

                        <StackPanel x:Name="RepeatPasswordPanel" Visibility="Collapsed">
                            <TextBlock Text="Повторите пароль" Foreground="#344054" FontSize="13" FontWeight="SemiBold" />
                            <PasswordBox x:Name="RepeatPasswordBox" Height="44" Margin="0,7,0,18" Padding="12,9" FontSize="15" BorderBrush="#D0D5DD" />
                        </StackPanel>

                        <Button x:Name="SubmitButton" Content="Войти" Height="48" Click="SubmitButton_Click"
                                Background="#315FCA" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" Foreground="#B42318" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
                        <Button Content="←  Вернуться в каталог" Click="BackToCatalog_Click" HorizontalAlignment="Left"
                                Background="Transparent" Foreground="#315FCA" BorderThickness="0" Padding="0" Margin="0,24,0,0" FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>