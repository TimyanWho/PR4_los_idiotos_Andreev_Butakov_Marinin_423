<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора"
      Background="#F4F6FA"
      FontFamily="Segoe UI"
      Loaded="Page_Loaded">

    <Page.Resources>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#19233A"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="7"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Background" Value="#3157D5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Page.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">

            <StackPanel>
                <TextBlock Text="Панель администратора"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#19233A"/>

                <TextBlock Text="Управление товарами, категориями, ПВЗ, заказами и отзывами"
                           Foreground="#718096"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Content="Обновить данные"
                    Style="{StaticResource ActionButton}"
                    VerticalAlignment="Center"
                    Click="Refresh_Click"/>

        </DockPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Проверка прав администратора..."
                   Foreground="#667085"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TabControl x:Name="AdminTabs"
                    Grid.Row="2"
                    Background="White">

            <!-- ТОВАРЫ -->
            <TabItem Header="Товары">

                <Grid Margin="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="ProductsGrid"
                              Grid.Column="0"
                              SelectionChanged="ProductsGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Цена"
                                                Binding="{Binding Price, StringFormat={}{0:N2} ₽}"
                                                Width="95"/>

                            <DataGridTextColumn Header="Остаток"
                                                Binding="{Binding StockQuantity}"
                                                Width="75"/>

                            <DataGridCheckBoxColumn Header="Доступен"
                                                    Binding="{Binding IsAvailable}"
                                                    Width="75"/>
                        </DataGrid.Columns>

                    </DataGrid>

                    <Border Grid.Column="2"
                            Background="#F8FAFD"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="Карточка товара"
                                           Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Выберите товар слева для редактирования или нажмите «Очистить» для создания нового."
                                           Foreground="#718096"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,8"/>

                                <TextBlock Text="Название"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="ProductNameBox"
                                         Style="{StaticResource FieldBox}"/>

                                <TextBlock Text="Цена, ₽"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="ProductPriceBox"
                                         Style="{StaticResource FieldBox}"/>

                                <TextBlock Text="Категория"
                                           Style="{StaticResource FieldLabel}"/>

                                <ComboBox x:Name="ProductCategoryComboBox"
                                          MinHeight="34"
                                          Padding="6"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"/>

                                <TextBlock Text="Путь к изображению"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="ProductImageBox"
                                         Style="{StaticResource FieldBox}"
                                         ToolTip="Например: xphone15.jpg"/>

                                <TextBlock Text="Количество на складе"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="ProductStockBox"
                                         Style="{StaticResource FieldBox}"/>

                                <TextBlock Text="Штук в упаковке (необязательно)"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="ProductPackageBox"
                                         Style="{StaticResource FieldBox}"/>

                                <TextBlock Text="Описание"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="ProductDescriptionBox"
                                         MinHeight="85"
                                         Padding="7"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>

                                <CheckBox x:Name="ProductAvailableCheckBox"
                                          Content="Товар доступен для покупки"
                                          IsChecked="True"
                                          Margin="0,13,0,4"/>

                                <WrapPanel>

                                    <Button Content="Сохранить товар"
                                            Style="{StaticResource ActionButton}"
                                            Click="SaveProduct_Click"/>

                                    <Button Content="Очистить / Новый"
                                            Background="#E4E7EC"
                                            Foreground="#344054"
                                            Style="{StaticResource ActionButton}"
                                            Click="ClearProductForm_Click"/>

                                </WrapPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- КАТЕГОРИИ -->
            <TabItem Header="Категории">

                <Grid Margin="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Существующие категории"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,12"/>

                        <ListBox x:Name="CategoriesList"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="CategoriesList_SelectionChanged"
                                 MinHeight="260"/>

                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#F8FAFD"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Добавить или переименовать"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Название категории"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="CategoryNameBox"
                                     Style="{StaticResource FieldBox}"/>

                            <WrapPanel>

                                <Button Content="Сохранить категорию"
                                        Style="{StaticResource ActionButton}"
                                        Click="SaveCategory_Click"/>

                                <Button Content="Очистить"
                                        Background="#E4E7EC"
                                        Foreground="#344054"
                                        Style="{StaticResource ActionButton}"
                                        Click="ClearCategory_Click"/>

                            </WrapPanel>

                            <TextBlock Text="Удаление категорий не добавлено: на них могут ссылаться существующие товары."
                                       Foreground="#718096"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ПВЗ -->
            <TabItem Header="Пункты выдачи">

                <Grid Margin="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Существующие ПВЗ"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,12"/>

                        <ListBox x:Name="PickupPointsList"
                                 DisplayMemberPath="DisplayName"
                                 SelectionChanged="PickupPointsList_SelectionChanged"
                                 MinHeight="260"/>

                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#F8FAFD"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Данные пункта выдачи"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Название"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="PickupNameBox"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="Адрес"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="PickupAddressBox"
                                     Style="{StaticResource FieldBox}"/>

                            <WrapPanel>

                                <Button Content="Сохранить ПВЗ"
                                        Style="{StaticResource ActionButton}"
                                        Click="SavePickupPoint_Click"/>

                                <Button Content="Очистить"
                                        Background="#E4E7EC"
                                        Foreground="#344054"
                                        Style="{StaticResource ActionButton}"
                                        Click="ClearPickupPoint_Click"/>

                                <Button Content="Удалить"
                                        Background="#B42318"
                                        Style="{StaticResource ActionButton}"
                                        Click="DeletePickupPoint_Click"/>

                            </WrapPanel>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ЗАКАЗЫ -->
            <TabItem Header="Заказы">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="OrdersGrid"
                              Grid.Row="0"
                              SelectionChanged="OrdersGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Заказ №"
                                                Binding="{Binding Id}"
                                                Width="75"/>

                            <DataGridTextColumn Header="Дата"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                Width="145"/>

                            <DataGridTextColumn Header="Покупатель"
                                                Binding="{Binding Buyer}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Получение"
                                                Binding="{Binding DeliveryType}"
                                                Width="115"/>

                            <DataGridTextColumn Header="Сумма"
                                                Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding Status}"
                                                Width="150"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Background="#F8FAFD"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,12,0,0">

                        <DockPanel>

                            <Button DockPanel.Dock="Right"
                                    Content="Изменить статус"
                                    Style="{StaticResource ActionButton}"
                                    Margin="12,0,0,0"
                                    Click="UpdateOrderStatus_Click"/>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Новый статус:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,0"/>

                                <ComboBox x:Name="OrderStatusComboBox"
                                          Width="220"
                                          MinHeight="34"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"/>

                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ОТЗЫВЫ -->
            <TabItem Header="Отзывы">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">

                        <TextBlock Text="Товар:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <ComboBox x:Name="ReviewProductComboBox"
                                  Width="360"
                                  MinHeight="34"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="ReviewProductComboBox_SelectionChanged"/>

                    </StackPanel>

                    <DataGrid x:Name="ReviewsGrid"
                              Grid.Row="1"
                              SelectionChanged="ReviewsGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Автор"
                                                Binding="{Binding Author}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Оценка"
                                                Binding="{Binding Rating}"
                                                Width="75"/>

                            <DataGridTextColumn Header="Комментарий"
                                                Binding="{Binding Comment}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Дата"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                Width="145"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="Удалить выбранный отзыв"
                            Background="#B42318"
                            Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Left"
                            Click="DeleteReview_Click"/>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>