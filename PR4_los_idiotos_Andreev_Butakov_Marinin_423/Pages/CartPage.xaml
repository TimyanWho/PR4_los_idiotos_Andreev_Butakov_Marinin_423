<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина"
      Background="#F3F5FA">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,24,0">
            <DockPanel Margin="0,0,0,22">
                <Button Content="←  К каталогу" Click="BackToCatalog_Click" DockPanel.Dock="Right"
                        Background="Transparent" Foreground="#315FCA" BorderThickness="0" FontSize="14" />
                <StackPanel>
                    <TextBlock Text="Корзина" Foreground="#172B55" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Проверьте товары и их количество перед оформлением." Foreground="#667085" FontSize="14" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <Border x:Name="ApiStatusPanel" Background="White" BorderBrush="#E5E9F2" BorderThickness="1" CornerRadius="14" Padding="24" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Корзина появится здесь" Foreground="#172B55" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApiStatusText" Text="Клиент корзины API ещё не подключён. После согласования маршрутов здесь появятся товары." Foreground="#667085" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="EmptyStatePanel" Background="White" BorderBrush="#E5E9F2" BorderThickness="1" CornerRadius="14" Padding="24" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Пока пусто" Foreground="#172B55" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Добавьте товары из каталога — они появятся в этом списке." Foreground="#667085" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,16" />
                    <Button Content="Перейти в каталог" Click="BackToCatalog_Click" HorizontalAlignment="Left"
                            Background="#315FCA" Foreground="White" BorderThickness="0" Padding="16,10" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="CartItemsList" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E5E9F2" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Foreground="#172B55" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Foreground="#667085" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,8" />
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} ₽ за штуку}" Foreground="#475467" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="−" Tag="decrease" Click="QuantityButton_Click" Width="32" Height="32" />
                                    <TextBlock Text="{Binding Quantity}" Foreground="#172B55" FontSize="16" VerticalAlignment="Center" Margin="12,0" />
                                    <Button Content="+" Tag="increase" Click="QuantityButton_Click" Width="32" Height="32" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2} ₽}" Foreground="#172B55" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <Button Content="Удалить" Click="RemoveItem_Click" Background="Transparent" Foreground="#B42318" BorderThickness="0" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Column="1" Background="White" BorderBrush="#E5E9F2" BorderThickness="1" CornerRadius="16" Padding="22" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Ваш заказ" Foreground="#172B55" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="CartCountText" Text="0 товаров" Foreground="#667085" FontSize="14" Margin="0,8,0,18" />
                <Border Height="1" Background="#E5E9F2" />
                <DockPanel Margin="0,18,0,8">
                    <TextBlock Text="Итого" Foreground="#344054" FontSize="15" />
                    <TextBlock x:Name="TotalText" Text="0,00 ₽" Foreground="#172B55" FontSize="18" FontWeight="Bold" DockPanel.Dock="Right" />
                </DockPanel>
                <TextBlock Text="Доставка и способ получения выбираются при оформлении." Foreground="#667085" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18" />
                <Button x:Name="CheckoutButton" Content="Оформить заказ" Click="Checkout_Click" Height="46"
                        Background="#315FCA" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" IsEnabled="False" />
                <TextBlock x:Name="StatusText" Foreground="#B54708" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>