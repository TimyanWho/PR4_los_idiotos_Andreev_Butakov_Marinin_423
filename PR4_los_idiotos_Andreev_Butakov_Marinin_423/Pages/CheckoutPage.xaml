<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.Pages.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Оформление заказа"
      Background="#F4F6FA"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#19233A"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#718096"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Background" Value="#3157D5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Оформление заказа"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#19233A"/>

                    <TextBlock Text="Выберите способ получения и проверьте состав покупки."
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="←  Назад в корзину"
                        Click="BackToCart_Click"
                        Background="Transparent"
                        Foreground="#3157D5"
                        BorderThickness="0"
                        FontSize="14"
                        VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <!-- СОСТАВ ЗАКАЗА -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E7EBF2"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="22"
                        Margin="0,0,18,0">

                    <StackPanel>
                        <TextBlock Text="Состав покупки"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock x:Name="ItemsCountText"
                                   Text="Товаров: 0"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,5,0,16"/>

                        <ItemsControl x:Name="CheckoutItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E7EBF2"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#19233A"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0} шт. ×}"
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,5,0,0"/>

                                                <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} ₽ за штуку}"
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LineTotal, StringFormat={}{0:N2} ₽}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#19233A"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyItemsText"
                                   Text="В покупке нет товаров. Вернитесь в каталог или корзину."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- СПОСОБ ПОЛУЧЕНИЯ -->
                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E7EBF2"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="22"
                        VerticalAlignment="Top">

                    <StackPanel>
                        <TextBlock Text="Способ получения"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Доставка по адресу доступна при сумме заказа больше 600 ₽."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14"/>

                        <RadioButton x:Name="PickupRadioButton"
                                     Content="Самовывоз из ПВЗ"
                                     GroupName="DeliveryMethod"
                                     IsChecked="True"
                                     FontSize="14"
                                     Foreground="#26334D"
                                     Margin="0,4,0,8"
                                     Checked="DeliveryMethod_Changed"/>

                        <Border x:Name="PickupPanel"
                                Background="#F8FAFD"
                                BorderBrush="#E7EBF2"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">

                            <StackPanel>
                                <TextBlock Text="Пункт выдачи заказов"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="PickupPointComboBox"
                                          Height="36"
                                          Padding="7"
                                          DisplayMemberPath="DisplayName"/>

                                <TextBlock x:Name="PickupStatusText"
                                           Text="Загружаем список ПВЗ..."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <RadioButton x:Name="DeliveryRadioButton"
                                     Content="Доставка по адресу"
                                     GroupName="DeliveryMethod"
                                     IsEnabled="False"
                                     FontSize="14"
                                     Foreground="#26334D"
                                     Margin="0,16,0,8"
                                     Checked="DeliveryMethod_Changed"/>

                        <Border x:Name="DeliveryPanel"
                                Background="#F8FAFD"
                                BorderBrush="#E7EBF2"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Visibility="Collapsed">

                            <StackPanel>
                                <TextBlock Text="Адрес доставки"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="DeliveryAddressBox"
                                         MinHeight="70"
                                         Padding="8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         ToolTip="Город, улица, дом, квартира"/>
                            </StackPanel>
                        </Border>

                        <Border Height="1"
                                Background="#E7EBF2"
                                Margin="0,20,0,16"/>

                        <Grid>
                            <TextBlock Text="Итого к оплате"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#344054"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TotalText"
                                       Text="0,00 ₽"
                                       HorizontalAlignment="Right"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#3157D5"/>
                        </Grid>

                        <Button x:Name="PlaceOrderButton"
                                Content="Подтвердить заказ"
                                Style="{StaticResource ActionButton}"
                                Height="46"
                                Margin="0,20,0,0"
                                Click="PlaceOrder_Click"/>

                        <TextBlock x:Name="StatusText"
                                   Foreground="#B54708"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>