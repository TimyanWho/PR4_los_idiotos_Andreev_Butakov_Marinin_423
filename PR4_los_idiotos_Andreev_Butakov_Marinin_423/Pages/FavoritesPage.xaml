<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.Pages.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Избранное"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Избранное"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Здесь находятся товары, которые вы сохранили."
                       Foreground="Gray"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="StatusText"
                       Text="Загрузка избранного..."
                       Foreground="Gray"
                       Margin="0,0,0,15"/>

            <TextBlock x:Name="EmptyText"
                       Text="Ваш список избранного пока пуст."
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,30"
                       Visibility="Visible"/>

            <ItemsControl x:Name="FavoritesItemsControl"
                          Visibility="Collapsed">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="245"
                                Margin="0,0,16,16"
                                Padding="12"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="White">

                            <StackPanel>

                                <Image Source="{Binding ImagePath}"
                                       Height="150"
                                       Stretch="Uniform"
                                       Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding Category}"
                                           Foreground="Gray"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding RatingText}"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding AvailableText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding PackageText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <Button Content="Подробнее"
                                        Padding="10,7"
                                        Margin="0,0,0,6"
                                        Click="Details_Click"/>

                                <Button Content="В корзину"
                                        Padding="10,7"
                                        Margin="0,0,0,6"
                                        Click="AddToCart_Click"/>

                                <Button Content="Убрать из избранного"
                                        Padding="10,7"
                                        Click="RemoveFavorite_Click"/>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
