<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заказы"
      Background="#F4F6FA"
      FontFamily="Segoe UI">
    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#19233A" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#718096" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="#3157D5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="OrderListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="16">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#3157D5" />
                                <Setter TargetName="Card" Property="Background" Value="#F8FAFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A8B8EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,28,36,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Мои заказы" FontSize="30" FontWeight="Bold" Foreground="#19233A" />
                    <TextBlock Text="История покупок и подробности доставки" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Обновить" Style="{StaticResource ActionButton}" Click="RefreshButton_Click" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="18" Padding="22">
                <Grid>
                    <StackPanel x:Name="EmptyStatePanel" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="520">
                        <TextBlock Text="◷" FontSize="42" Foreground="#3157D5" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock x:Name="EmptyTitleText" Text="Заказов пока нет" FontSize="20" FontWeight="SemiBold" Foreground="#19233A" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyDescriptionText" Text="Оформленные покупки появятся здесь." Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <Grid x:Name="OrdersContentPanel" Visibility="Collapsed" MinHeight="460">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*" MinWidth="280" />
                            <ColumnDefinition Width="1.25*" MinWidth="340" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Заказы" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SortComboBox" Grid.Column="1" Width="148" SelectedIndex="0" SelectionChanged="SortComboBox_SelectionChanged" VerticalContentAlignment="Center" Padding="8,5">
                                <ComboBoxItem Content="Сначала новые" Tag="newest" />
                                <ComboBoxItem Content="Сначала старые" Tag="oldest" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Состав заказа" Style="{StaticResource SectionTitle}" Margin="18,0,0,16" VerticalAlignment="Center" />

                        <ListBox x:Name="OrdersList" Grid.Row="1" Grid.Column="0" Margin="0,0,18,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource OrderListItem}" SelectionChanged="OrdersList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding OrderId, StringFormat=Заказ №{0}}" FontSize="15" FontWeight="SemiBold" Foreground="#19233A" />
                                            <TextBlock Text="{Binding Status}" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#3157D5" />
                                        </Grid>
                                        <TextBlock Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="{Binding DeliverySummary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#19233A" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFD" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="14" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SelectedOrderPanel" DataContext="{Binding SelectedOrder}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrderId, StringFormat=Заказ №{0}}" FontSize="18" FontWeight="Bold" Foreground="#19233A" />
                                            <TextBlock Text="{Binding OrderDate, StringFormat={}{0:dd MMMM yyyy HH:mm}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8EEFF" CornerRadius="10" Padding="10,5">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#3157D5" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Получение" FontSize="14" FontWeight="SemiBold" Foreground="#19233A" Margin="0,22,0,7" />
                                    <TextBlock Text="{Binding DeliverySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

                                    <TextBlock Text="Товары" FontSize="14" FontWeight="SemiBold" Foreground="#19233A" Margin="0,22,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E7EBF2" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="#26334D" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0} шт.}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2} ₽}" FontSize="13" FontWeight="SemiBold" Foreground="#26334D" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} ₽ за шт.}" Style="{StaticResource MutedText}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,18,0,0">
                                        <TextBlock Text="Итого" FontSize="15" FontWeight="SemiBold" Foreground="#19233A" />
                                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#3157D5" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>