<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.Pages.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6FA">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="← Назад в каталог"
                HorizontalAlignment="Left"
                Padding="12,8"
                Click="Back_Click"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E5EF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22"
                Margin="0,16,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F4F6FA"
                            CornerRadius="10"
                            Padding="12"
                            Height="360"
                            VerticalAlignment="Top">

                        <Image Source="{Binding ImagePath}"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="26,0,0,0">

                        <TextBlock Text="{Binding Category}"
                                   Foreground="#667085"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding Name}"
                                   Foreground="#172033"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}"
                                   Foreground="#5269E8"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding RatingText}"
                                   Foreground="#667085"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding AvailableText}"
                                   Foreground="#172033"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding StockQuantity, StringFormat=Остаток: {0} шт.}"
                                   Foreground="#667085"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding PackageText}"
                                   Foreground="#667085"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Описание товара"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   Foreground="#475467"
                                   Margin="0,0,0,22"/>

                        <Button Content="Добавить в избранное"
                                HorizontalAlignment="Stretch"
                                Click="AuthRequiredAction_Click"/>

                        <Button Content="Добавить в корзину"
                                HorizontalAlignment="Stretch"
                                Background="#6478F5"
                                Foreground="White"
                                BorderThickness="0"
                                Click="AuthRequiredAction_Click"/>

                        <Button Content="Купить сейчас"
                                HorizontalAlignment="Stretch"
                                Click="AuthRequiredAction_Click"/>

                        <TextBlock Text="Отзывы и оценки"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"
                                   Margin="0,24,0,8"/>

                        <TextBlock Text="Здесь будут отображаться отзывы покупателей."
                                   Foreground="#667085"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>