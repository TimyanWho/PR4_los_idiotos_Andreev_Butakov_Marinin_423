<Page x:Class="PR4_los_idiotos_Andreev_Butakov_Marinin_423.Pages.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6FA"
      Loaded="Page_Loaded">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="← Назад в каталог"
                HorizontalAlignment="Left"
                Padding="12,8"
                Click="Back_Click"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E5EF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22"
                Margin="0,16,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F4F6FA"
                            CornerRadius="10"
                            Padding="12"
                            Height="360"
                            VerticalAlignment="Top">
                        <Image Source="{Binding ImagePath}"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="26,0,0,0">

                        <TextBlock Text="{Binding Category}"
                                   Foreground="#667085"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding Name}"
                                   Foreground="#172033"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}"
                                   Foreground="#5269E8"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding RatingText}"
                                   Foreground="#667085"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding AvailableText}"
                                   Foreground="#172033"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding StockQuantity, StringFormat=Остаток: {0} шт.}"
                                   Foreground="#667085"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding PackageText}"
                                   Foreground="#667085"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Описание товара"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   Foreground="#475467"
                                   Margin="0,0,0,18"/>

                        <Button Content="Добавить в избранное"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="AddToFavorites_Click"/>

                        <StackPanel x:Name="PurchaseActionsPanel">
                            <Button Content="Добавить в корзину"
                                    HorizontalAlignment="Stretch"
                                    Background="#6478F5"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Margin="0,0,0,8"
                                    Click="AddToCart_Click"/>

                            <Button Content="Купить сейчас"
                                    HorizontalAlignment="Stretch"
                                    Click="BuyNow_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="ActionStatusText"
                                   TextWrapping="Wrap"
                                   Foreground="#667085"
                                   Margin="0,10,0,20"/>

                        <TextBlock Text="Отзывы покупателей"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"
                                   Margin="0,0,0,8"/>

                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="RetryReviewsButton"
                                    Content="Повторить"
                                    Padding="10,5"
                                    Margin="10,0,0,0"
                                    DockPanel.Dock="Right"
                                    Visibility="Collapsed"
                                    Click="RetryReviews_Click"/>

                            <TextBlock x:Name="ReviewsStatusText"
                                       Text="Ожидание загрузки отзывов..."
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       TextWrapping="Wrap"/>
                        </DockPanel>

                        <ItemsControl x:Name="ReviewsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F9FC"
                                            BorderBrush="#E7EAF1"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="#667085"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding AuthorName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#172033"/>
                                            </DockPanel>

                                            <TextBlock Text="{Binding Rating, StringFormat=★ {0}/5}"
                                                       Foreground="#B7791F"
                                                       Margin="0,0,0,5"/>

                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#475467"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="ReviewAccessHint"
                                   TextWrapping="Wrap"
                                   Foreground="#667085"
                                   Margin="0,8,0,8"/>

                        <StackPanel x:Name="ReviewEditorPanel"
                                    Visibility="Collapsed">
                            <TextBlock Text="Оставить отзыв"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#172033"
                                       Margin="0,10,0,8"/>

                            <ComboBox x:Name="ReviewRatingBox"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Left"
                                      Width="210"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="5 — Отлично" Tag="5"/>
                                <ComboBoxItem Content="4 — Хорошо" Tag="4"/>
                                <ComboBoxItem Content="3 — Нормально" Tag="3"/>
                                <ComboBoxItem Content="2 — Плохо" Tag="2"/>
                                <ComboBoxItem Content="1 — Очень плохо" Tag="1"/>
                            </ComboBox>

                            <TextBox x:Name="ReviewTextBox"
                                     MinHeight="86"
                                     MaxLength="1200"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="8"
                                     Margin="0,0,0,8"/>

                            <Button Content="Опубликовать отзыв"
                                    HorizontalAlignment="Left"
                                    Padding="14,7"
                                    Click="SubmitReview_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>